<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Écriture dans Téléchargements — uniquement nécessaire sur Android 9 (API 28) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- USB OTG host mode requis pour communiquer avec la montre -->
    <uses-feature android:name="android.hardware.usb.host" />

    <!-- BLE (experimental, v0.3.0) — Ambit3/Traverse only, see AmbitBleModule.kt.
         API 31+ (Android 12+): new granular Bluetooth runtime permissions.
         neverForLocation is safe here — the scan filters by GATT service UUID,
         it doesn't need to derive location from scan results. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Pre-API 31: legacy Bluetooth permissions (normal, not runtime) plus
         location, which BLE scanning required as a runtime permission on
         these versions. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
<activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Lancer l'app automatiquement quand la montre est branchée -->
        <intent-filter>
            <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
        </intent-filter>
        <!-- Callback OAuth2 Strava : opensportsync://oauth/strava?code=... -->
        <intent-filter android:label="OAuth Strava">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="opensportsync" android:host="oauth" android:pathPrefix="/strava" />
        </intent-filter>
        <!-- Callback OAuth2 Dropbox / Google Drive / OneDrive - added 2026-08-12, Backup &
             Restore cloud destinations. Same self-serve loopback-callback pattern as Strava
             above. -->
        <intent-filter android:label="OAuth Dropbox">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="opensportsync" android:host="oauth" android:pathPrefix="/dropbox" />
        </intent-filter>
        <intent-filter android:label="OAuth Google Drive">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="opensportsync" android:host="oauth" android:pathPrefix="/googledrive" />
        </intent-filter>
        <intent-filter android:label="OAuth OneDrive">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="opensportsync" android:host="oauth" android:pathPrefix="/onedrive" />
        </intent-filter>
        <meta-data
            android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
            android:resource="@xml/device_filter" />
      </activity>

      <!-- FileProvider pour partager les fichiers GPX vers d'autres apps (Android 7+) -->
      <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
              android:name="android.support.FILE_PROVIDER_PATHS"
              android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>
