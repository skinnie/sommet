__pycache__/
*.pyc
csrc/build/
venv/

# Personal, local-only training-coach scaffold. It is its own git repo (coach/.git)
# with NO remote, so it can never be pushed/published from this repository.
/coach/

# MkDocs build output (mkdocs build), regenerated from docs/ + mkdocs.yml
site/

# PyInstaller build tooling/output: venvs bake in absolute paths of the machine that
# created them, so they must never travel between machines (this broke a real Mac
# build once - "bad interpreter", the venv's own python3 shebang pointed at a Linux
# path). Regenerated automatically by tools/packaging/build_*.sh on first run.
tools/packaging/.build-venv/
build/

# tools/vendor/ambit_legacy_cli's compiled binary (build.sh output) - regenerated, not source,
# same reasoning as build/ above. The vendored openambit_libambit/build/ dir is already caught
# by the build/ pattern.
tools/vendor/ambit_legacy_cli/ambit_legacy_cli
tools/vendor/ambit_legacy_cli/ambit_legacy_cli.exe

# PyInstaller's actual output (the packaged Workout Builder binaries/.app bundles) -
# regenerated by tools/packaging/build_*.sh, same "build output, not source" reasoning as
# build/ above.
dist/

# Debug screenshots from troubleshooting real packaging build failures - scratch, not source.
tools/packaging/error*.jpg

# Analysis artifacts, deliberately not versioned on a public repository:
#  - SuuntoLink binaries and decompilation: proprietary Suunto software
#  - Microsoft redistributable DLLs
#  - pcap captures: they carry the watch serial number and personal POIs (home)
assets/
# ...but the top-level assets/ holds one file we authored ourselves: the activity table
# (84 ids, names, colours, one SVG symbol each) that tools/gen_activity_qml.py generates
# desktop/qml/ActivityTypes.qml from. Rooted patterns so nested assets/ dirs elsewhere in
# the tree (desktop/assets, android/.../assets) keep their blanket ignore.
!/assets/
/assets/*
!/assets/activity_types.json
!/assets/sportmode_rows.json
# desktop/assets is otherwise swept up by the blanket `assets/` rule (which exists for
# private/proprietary content), but the icon font is an Apache-2.0 asset we subset ourselves
# and the desktop app needs it to compile - so keep just it and its NOTICE, nothing else in
# desktop/assets. (Un-ignore each parent dir, re-ignore its contents, then whitelist the file.)
!desktop/assets/
desktop/assets/*
!desktop/assets/fonts/
desktop/assets/fonts/*
!desktop/assets/fonts/MaterialSymbolsRounded.ttf
!desktop/assets/fonts/NOTICE.md
# Coach's bundled sample catalogue (2026-08-21) - a tracked copy of coach/data/systm-sample.json
# (coach/ itself is NOT this - see that directory's own README, kept local-only/gitignored
# separately). CoachService.cpp reads this exact path at runtime.
!desktop/assets/coach/
desktop/assets/coach/*
!desktop/assets/coach/systm-sample.json
full-assets/
# Flash-region dumps from the watch — carry the watch serial number; never commit.
backups/

# Field reports pasted straight from a `write_nav.py settings` run: they quote BLE
# link keys and a phone MAC verbatim. Their findings belong in HANDOFF.md, with the
# values redacted; the raw notes stay local.
HANDOFF-append-*.md

# desktop/ (Qt app, was ambitapp-v2/ until the 2026-08-08 repo consolidation) own build tree
# and one-off cmake/make stdout captures made while iterating on real builds - scratch, not
# source.
desktop/build/
desktop/*.log
desktop/*.exitcode

# Repo-root debris found during the 2026-08-08 documentation audit (parallel-session
# artifacts, not source): a MEGAsync ignore-list config, a stray tools/ backup archive, an
# accidental clipboard-paste image, and a scratch terminal-session paste. None referenced
# from any doc.
/.megaignore
/tools.tar.gz
/image.png
/Unsaved Document 1

# Raw route/waypoint flash-region dumps from real hardware test sessions (before/after/
# backup/pre-mirror-test snapshots) - scratch captured while debugging, not source, and
# potentially carrying real personal route data - never meant to be versioned.
*-routes.bin
*-waypoints.bin

# Generated stub so SuuntoLink JS can be required outside Electron (gen_sportmode_rows.js).
/tools/.node_shim/

# Local Python virtualenv at the repo root (same reasoning as venv/ above - machine-local,
# regenerated, never travels).
.venv/

# Suunto App catalog — Suunto's own App-Zone catalog data (catalog.bin/catalog.json + the
# raw source index.json), tens of MB, NOT ours to redistribute. Must never be versioned
# (the catalog was deliberately kept out of git and scrubbed from history before).
/data/suunto_apps/
/data/suunto_apps_source/

# Third-party reference repos cloned locally for study (openambit, opensportsync, AmbitSync,
# Movescount, pyambit, …) — each has its own .git, ~78 MB, not part of this project.
/githubprojects/

# Stray CMake configure artifacts if cmake is ever run from the repo root.
/CMakeFiles/

